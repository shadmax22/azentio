# Azentio Retail Loan Intake Agent Environment Variables
# Offline execution works deterministically with FakeProvider by default (no env vars required)

# LLM Provider Configuration (Optional real LLM provider)
LLM_PROVIDER=fake
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Optional override; defaults to data/intake.db)
INTAKE_DB_PATH=data/intake.db

# Agent Configuration
CONFIDENCE_THRESHOLD=0.8
STEP_BUDGET=12
